  "lines": [
    { "tier": 1, "event": "worlds", "text": "又大满败了，我一点都不意外" },
    { "tier": 1, "event": "worlds", "text": "{name}这大满败，比剧本还稳" },
    { "tier": 1, "event": "worlds", "text": "虚空六冠，谁给你数的" },
    { "tier": 1, "event": "worlds", "text": "{name}的虚空冠军，我笑了" },
    { "tier": 1, "event": "worlds", "text": "本质16强，别装了" },
    { "tier": 1, "event": "worlds", "text": "我说实话，本质就是16强" },
    { "tier": 1, "event": "worlds", "text": "本质亚军，早看出来了" },
    { "tier": 1, "event": "worlds", "text": "又是本质亚军，习惯了" },
    { "tier": 1, "event": "worlds", "text": "输了就游回家吧，别丢人" },
    { "tier": 1, "event": "worlds", "text": "外战输了直接游回家" },
    { "tier": 1, "event": "worlds", "text": "飞机票早买好了吧" },
    { "tier": 1, "event": "worlds", "text": "藏飞机票这事，藏不住的" },
    { "tier": 1, "event": "worlds", "text": "外战就腿软，我说实话" },
    { "tier": 1, "event": "worlds", "text": "只会打自家人，出去就没了" },
    { "tier": 1, "event": "worlds", "text": "签运选手，抽到谁都一样输" },
    { "tier": 1, "event": "worlds", "text": "内战幻神，外战看笑话" },
    { "tier": 1, "event": "worlds", "text": "{country}这届又没戏了" },
    { "tier": 1, "event": "worlds", "text": "出国打比赛，状态全是零" },
    { "tier": 1, "event": "worlds", "text": "小组赛都过不去，别吹了" },
    { "tier": 1, "event": "worlds", "text": "我上也是输，少丢点人" },

    { "tier": 2, "event": "worlds", "text": "大满败也算一种全勤吧" },
    { "tier": 2, "event": "worlds", "text": "{name}这大满败，数据挺好看" },
    { "tier": 2, "event": "worlds", "text": "虚空三冠，含金量我打个问号" },
    { "tier": 2, "event": "worlds", "text": "拿虚空冠军说事，不太合适" },
    { "tier": 2, "event": "worlds", "text": "客观讲，本质就是16强" },
    { "tier": 2, "event": "worlds", "text": "签运好而已，本质16强" },
    { "tier": 2, "event": "worlds", "text": "本质亚军，还差一口气" },
    { "tier": 2, "event": "worlds", "text": "亚军也是本质，别抬了" },
    { "tier": 2, "event": "worlds", "text": "游回家之前，先看看数据吧" },
    { "tier": 2, "event": "worlds", "text": "输了游回家，路上慢慢想" },
    { "tier": 2, "event": "worlds", "text": "飞机票藏得再深也会被翻出" },
    { "tier": 2, "event": "worlds", "text": "别装了，飞机票早就买好" },
    { "tier": 2, "event": "worlds", "text": "我说句客观的，外战真一般" },
    { "tier": 2, "event": "worlds", "text": "捧了半天，外战一碰就碎" },
    { "tier": 2, "event": "worlds", "text": "拿过去的成绩说话，站不住" },
    { "tier": 2, "event": "worlds", "text": "内战数据好看，出来就现原形" },
    { "tier": 2, "event": "worlds", "text": "比起{rival}的外战履历，差多了" },
    { "tier": 2, "event": "worlds", "text": "{time}再漂亮，外战还是没赢" },
    { "tier": 2, "event": "worlds", "text": "分组抽得好，也能吹一年" },
    { "tier": 2, "event": "worlds", "text": "{country}这代人是真不行" },

    { "tier": 3, "event": "worlds", "text": "大满败怎么了，版本不背锅吗" },
    { "tier": 3, "event": "worlds", "text": "别喊大满败了，赛程对他不公" },
    { "tier": 3, "event": "worlds", "text": "{rival}那虚空冠军，也好意思提" },
    { "tier": 3, "event": "worlds", "text": "虚空冠军就别来碰瓷了" },
    { "tier": 3, "event": "worlds", "text": "16强也是被赛程坑的" },
    { "tier": 3, "event": "worlds", "text": "谁说他本质16强，出来聊聊" },
    { "tier": 3, "event": "worlds", "text": "本质亚军？亚军也是世界第二" },
    { "tier": 3, "event": "worlds", "text": "亚军怎么了，比你们强多了" },
    { "tier": 3, "event": "worlds", "text": "让他游回家？你们配吗" },
    { "tier": 3, "event": "worlds", "text": "游回家这种话，等你们进过再说" },
    { "tier": 3, "event": "worlds", "text": "他藏飞机票？明明是赛程问题" },
    { "tier": 3, "event": "worlds", "text": "藏飞机票这话，太伤人了吧" },
    { "tier": 3, "event": "worlds", "text": "同赛区那几个，外战更难看" },
    { "tier": 3, "event": "worlds", "text": "对面全是版本队，赢不了怪谁" },
    { "tier": 3, "event": "worlds", "text": "黑{name}的先看看外战记录" },
    { "tier": 3, "event": "worlds", "text": "输了也轮不到你们指指点点" },
    { "tier": 3, "event": "worlds", "text": "{club}的投入就这待遇" },
    { "tier": 3, "event": "worlds", "text": "赛程三天三场，谁顶得住" },
    { "tier": 3, "event": "worlds", "text": "换谁上都得输，别说了" },
    { "tier": 3, "event": "worlds", "text": "外战内行？先拿个冠军再讲" },

    { "tier": 4, "event": "worlds", "text": "大满败之后，历史得重写一遍" },
    { "tier": 4, "event": "worlds", "text": "只认成绩，大满败就是大满败" },
    { "tier": 4, "event": "worlds", "text": "虚空九冠，够写进史书了" },
    { "tier": 4, "event": "worlds", "text": "别拿虚空冠军比历史地位" },
    { "tier": 4, "event": "worlds", "text": "本质16强，历史书上就这一行" },
    { "tier": 4, "event": "worlds", "text": "16强的成绩，进不了前十" },
    { "tier": 4, "event": "worlds", "text": "本质亚军，历史不会记住第二" },
    { "tier": 4, "event": "worlds", "text": "亚军就是亚军，没什么本质" },
    { "tier": 4, "event": "worlds", "text": "游回家这一幕，我截图了" },
    { "tier": 4, "event": "worlds", "text": "游回家，也是历史的一部分" },
    { "tier": 4, "event": "worlds", "text": "藏飞机票的，历史都记不清" },
    { "tier": 4, "event": "worlds", "text": "飞机票都备好了，还谈什么争冠" },
    { "tier": 4, "event": "worlds", "text": "见证历史还是见证塌房" },
    { "tier": 4, "event": "worlds", "text": "赢了就是传奇，输了就塌房" },
    { "tier": 4, "event": "worlds", "text": "以前那些吹上天的，外战也这样" },
    { "tier": 4, "event": "worlds", "text": "旧神的外战记录，翻出来看看" },
    { "tier": 4, "event": "worlds", "text": "{name}的时间不多了" },
    { "tier": 4, "event": "worlds", "text": "只认世界赛，其他都不算数" },
    { "tier": 4, "event": "worlds", "text": "这一届就是他的最后机会" },
    { "tier": 4, "event": "worlds", "text": "旧时代的王，今天该下课了" }
  ]
}
