<Project>
  <PropertyGroup>
    <PackageRoot>$(MSBuildProjectDirectory)/obj/packages</PackageRoot>
    <KernelArchive>CombatSolver-0.51.4.zip</KernelArchive>
    <LibraryArchive>STS2-RitsuLib.0.6.12.variant-pack.zip</LibraryArchive>
  </PropertyGroup>
  <Target Name="PrepareLeagueEngine" BeforeTargets="ResolveAssemblyReferences;PrepareResources" Inputs="$(MSBuildThisFileFullPath)" Outputs="$(PackageRoot)/embedded.zip;$(PackageRoot)/solver/CombatSolver.dll">
    <MakeDir Directories="$(PackageRoot)" />
    <DownloadFile SourceUrl="https://github.com/Torch1230/CombatSolver/releases/download/v0.51.4/$(KernelArchive)" DestinationFolder="$(PackageRoot)" Condition="!Exists('$(PackageRoot)/$(KernelArchive)')" />
    <DownloadFile SourceUrl="https://github.com/BAKAOLC/STS2-RitsuLib/releases/download/v0.6.12/$(LibraryArchive)" DestinationFolder="$(PackageRoot)" Condition="!Exists('$(PackageRoot)/$(LibraryArchive)')" />
    <VerifyFileHash File="$(PackageRoot)/$(KernelArchive)" Hash="eea761bfc045a0f99f336081e8f460065e853e8482806a8bed0256ab3009bed5" Algorithm="SHA256" />
    <VerifyFileHash File="$(PackageRoot)/$(LibraryArchive)" Hash="0ba8f3a99ad62e1c3fb6318aeaa4768501cff923d76e184cc6e7b284c71f00ab" Algorithm="SHA256" />
    <Unzip SourceFiles="$(PackageRoot)/$(KernelArchive)" DestinationFolder="$(PackageRoot)/solver" />
    <Unzip SourceFiles="$(PackageRoot)/$(LibraryArchive)" DestinationFolder="$(PackageRoot)/library" />
    <ItemGroup>
      <EngineFiles Include="$(PackageRoot)/solver/CombatSolver.dll;$(PackageRoot)/library/shared/*.dll;$(PackageRoot)/library/compat/0.113.0/*.dll;$(MSBuildThisFileDirectory)CombatSolver-LICENSE;$(MSBuildThisFileDirectory)CombatSolver-THIRD_PARTY_NOTICES.txt;$(MSBuildThisFileDirectory)RitsuLib-LICENSE" />
    </ItemGroup>
    <Copy SourceFiles="@(EngineFiles)" DestinationFolder="$(PackageRoot)/runtime" />
    <ZipDirectory SourceDirectory="$(PackageRoot)/runtime" DestinationFile="$(PackageRoot)/embedded.zip" Overwrite="true" />
  </Target>
</Project>